@startchen
title 股票筛选增强项目数据库范式设计

' 来源：web/prisma/schema.prisma
' 字段以主键、外键和业务核心字段为主；Json/String[] 字段表示结构化快照或集合边界。

entity User {
  id <<key>>
  name
  email
}

entity Account {
  id <<key>>
  userId <<FK>>
  provider
  providerAccountId
}

entity Session {
  id <<key>>
  userId <<FK>>
  sessionToken
  expires
}

entity VerificationToken {
  identifier <<key>>
  token <<key>>
  expires
}

entity Post {
  id <<key>>
  name
  createdById <<FK>>
  createdAt
}

entity ScreeningWorkspace {
  id <<key>>
  userId <<FK>>
  name
  stockCodes
  indicatorIds
  formulaIds
  timeConfig
  filterRules
  resultSnapshot
}

entity ScreeningFormula {
  id <<key>>
  userId <<FK>>
  name
  expression
  targetIndicators
  categoryId
}

entity WatchList {
  id <<key>>
  userId <<FK>>
  name
  stocks
}

entity ResearchSpace {
  id <<key>>
  userId <<FK>>
  name
  briefJson
}

entity ResearchSpaceRunLink {
  id <<key>>
  spaceId <<FK>>
  runId <<FK>>
  note
}

entity ResearchSpaceWatchListLink {
  id <<key>>
  spaceId <<FK>>
  watchListId <<FK>>
}

entity ResearchSpaceStockLink {
  id <<key>>
  spaceId <<FK>>
  stockCode
  stockName
}

entity SavedCompany {
  id <<key>>
  userId <<FK>>
  stockCode
  companyName
  tags
  metadataJson
}

entity SavedIndustry {
  id <<key>>
  userId <<FK>>
  name
  source
  relatedCompaniesJson
  metadataJson
}

entity ResearchNote {
  id <<key>>
  userId <<FK>>
  targetType
  targetId
  title
  contentMarkdown
  sourceJson
}

entity FinancialSnapshot {
  id <<key>>
  userId <<FK>>
  targetType
  targetId
  companyRefsJson
  metricSetJson
  periodRangeJson
  rawSnapshotJson
}

entity ResearchArtifact {
  id <<key>>
  userId <<FK>>
  targetType
  targetId
  financialSnapshotId <<FK>>
  artifactType
  payloadJson
}

entity EvidenceContext {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  subjectType
  subjectId
  phase
  metadataJson
}

entity EvidenceContextBlock {
  id <<key>>
  contextId <<FK>>
  blockKey
  status
  sourceType
  sourceId
  metadataJson
}

entity EvidenceContextItem {
  id <<key>>
  contextId <<FK>>
  blockId <<FK>>
  userId <<FK>>
  itemKey
  status
  extractedFact
  sourceType
  lineageId
  contentHash
}

entity ResearchContextSnapshot {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  requestGroupId
  requestSequence
  purpose
  model
  messagesJson
  qualityJson
  status
}

entity ResearchContextSnapshotItem {
  id <<key>>
  snapshotId <<FK>>
  evidenceItemId <<FK>>
  ordinal
  projectionJson
  projectionHash
}

entity ResearchClaim {
  id <<key>>
  snapshotId <<FK>>
  artifactKey
  ordinal
  text
  status
  qualityFlags
}

entity ResearchClaimCitation {
  id <<key>>
  claimId <<FK>>
  evidenceItemId <<FK>>
  relation
}

entity ResearchReminder {
  id <<key>>
  userId <<FK>>
  timingReviewRecordId <<FK>>
  stockCode
  reminderType
  scheduledAt
  status
}

entity TimingSignalSnapshot {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  stockCode
  asOfDate
  timeframe
  bars
  indicators
  signalContext
}

entity TimingAnalysisCard {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  watchListId <<FK>>
  presetId <<FK>>
  signalSnapshotId <<FK>>
  stockCode
  actionBias
  confidence
  reasoning
}

entity PortfolioSnapshot {
  id <<key>>
  userId <<FK>>
  name
  baseCurrency
  cash
  totalCapital
  positions
  riskPreferences
}

entity TimingRecommendation {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  portfolioSnapshotId <<FK>>
  watchListId <<FK>>
  presetId <<FK>>
  stockCode
  action
  priority
  confidence
  reasoning
}

entity TimingReviewRecord {
  id <<key>>
  userId <<FK>>
  analysisCardId <<FK>>
  recommendationId <<FK>>
  stockCode
  reviewHorizon
  scheduledAt
  actualReturnPct
  verdict
}

entity TimingPreset {
  id <<key>>
  userId <<FK>>
  name
  config
}

entity TimingMarketContextSnapshot {
  id <<key>>
  asOfDate <<key>>
  state
  transition
  persistenceDays
  snapshotJson
  analysisJson
}

entity TimingFeedbackObservation {
  id <<key>>
  userId <<FK>>
  reviewRecordId <<FK>>
  recommendationId <<FK>>
  presetId <<FK>>
  stockCode
  reviewHorizon
  actualReturnPct
  verdict
}

entity TimingPresetAdjustmentSuggestion {
  id <<key>>
  userId <<FK>>
  presetId <<FK>>
  kind
  status
  title
  patch
  metrics
}

entity WorkflowTemplate {
  id <<key>>
  code
  version
  graphConfig
  inputSchema
  isActive
}

entity WorkflowRun {
  id <<key>>
  templateId <<FK>>
  userId <<FK>>
  query
  input
  status
  progressPercent
  currentNodeKey
  result
}

entity TimingKronosForecastSnapshot {
  id <<key>>
  userId <<FK>>
  workflowRunId <<FK>>
  stockCode
  asOfDate
  timeframe
  modelName
  forecastJson
}

entity WorkflowNodeRun {
  id <<key>>
  runId <<FK>>
  nodeKey
  agentName
  attempt
  status
  input
  output
}

entity WorkflowEvent {
  id <<key>>
  runId <<FK>>
  nodeRunId <<FK>>
  sequence
  eventType
  payload
  occurredAt
}

entity AgentToolCall {
  id <<key>>
  workflowRunId <<FK>>
  skillId
  toolName
  status
  inputSummary
  outputSummary
}

entity AgentArtifact {
  id <<key>>
  workflowRunId <<FK>>
  kind
  title
  contentType
  uri
  payload
}

entity AgentConversation {
  id <<key>>
  userId <<FK>>
  title
  status
  piSessionId
  legacyWorkflowRunId <<FK>>
}

entity AgentConversationMessage {
  id <<key>>
  conversationId <<FK>>
  workflowRunId <<FK>>
  role
  content
  status
  sequence
  metadata
}

