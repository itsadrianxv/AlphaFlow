{
  "$schema": "https://biomejs.dev/schemas/2.3.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "app/**/*.ts",
      "app/**/*.tsx",
      "app/**/*.js",
      "app/**/*.jsx",
      "contracts/**/*.ts",
      "contracts/**/*.tsx",
      "contracts/**/*.js",
      "contracts/**/*.jsx",
      "server/**/*.ts",
      "server/**/*.tsx",
      "server/**/*.js",
      "server/**/*.jsx",
      "tooling/**/*.ts",
      "tooling/**/*.js",
      "trpc/**/*.ts",
      "trpc/**/*.tsx",
      "trpc/**/*.js",
      "trpc/**/*.jsx",
      "env.js",
      "next.config.js",
      "postcss.config.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
