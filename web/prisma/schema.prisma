// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                            String                         @id @default(cuid())
  name                          String?
  email                         String?                        @unique
  emailVerified                 DateTime?
  image                         String?
  loginIdentifier               String?                        @unique
  loginIdentifierType           LoginIdentifierType?
  passwordHash                  String?
  sessionVersion                Int                            @default(0)
  status                        UserStatus                     @default(ACTIVE)
  passwordChangedAt             DateTime?
  accounts                      Account[]
  sessions                      Session[]
  posts                         Post[]
  screeningWorkspaces           ScreeningWorkspace[]
  screeningFormulas             ScreeningFormula[]
  screeningRuns                 ScreeningRun[]
  watchLists                    WatchList[]
  timingSignalSnapshots         TimingSignalSnapshot[]
  timingKronosForecastSnapshots TimingKronosForecastSnapshot[]
  timingResearchReports         TimingResearchReport[]
  portfolioCompositions         PortfolioComposition[]
  portfolioRiskDiagnostics      PortfolioRiskDiagnostic[]
  timingPresets                 TimingPreset[]
  timingPresetRevisions         TimingPresetRevision[]
  timingRuleValidationRuns      TimingRuleValidationRun[]
  workflowRuns                  WorkflowRun[]
  agentConversations            AgentConversation[]
  savedCompanies                SavedCompany[]
  savedIndustries               SavedIndustry[]
  researchNotes                 ResearchNote[]
  financialSnapshots            FinancialSnapshot[]
  researchArtifacts             ResearchArtifact[]
  evidenceContexts              EvidenceContext[]
  evidenceContextItems          EvidenceContextItem[]
  researchContextSnapshots      ResearchContextSnapshot[]
  scheduledTasks                ScheduledTask[]
  collections                   Collection[]
  mindMaps                      MindMap[]
  homepageDataManifests         HomepageDataManifest[]
  homepageSnapshots             HomepageSnapshot[]
  homepageCurrentSnapshots      HomepageCurrentSnapshotProjection[]
  researchPreference            ResearchPreference?
  researchPreferenceCommands    ResearchPreferenceCommand[]
  researchPreferenceSnapshots   ResearchPreferenceSnapshot[]
  researchRelevanceAssessments  ResearchEventRelevanceAssessment[]
  researchInboxEntries          ResearchInboxEntry[]
  researchInboxFeedback         ResearchInboxFeedback[]
  researchTasks                 ResearchTask[]
  researchAuditRecords          ResearchAuditRecord[]
}

enum LlmTaskExecutionStatus {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

model LlmTaskExecution {
  id             String                 @id @default(cuid())
  taskType       String
  idempotencyKey String                 @unique
  inputHash      String
  inputJson      Json                   @default("{}")
  status         LlmTaskExecutionStatus @default(PENDING)
  attempts       Int                    @default(0)
  workerId       String?
  fencingToken   BigInt                 @default(0)
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  nextAttemptAt  DateTime?
  eventPublishedAt DateTime?
  result         Json?
  error          Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([eventPublishedAt, status])
}

enum LoginIdentifierType {
  PHONE
  EMAIL
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ScheduledTaskStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
}

enum AgentConversationRoutingMode {
  AUTO
  SCHEDULED_TASK_SETUP
  SCHEDULED_TASK_EDIT
}

enum ScheduledTaskExecutionTrigger {
  SCHEDULED
  MANUAL
}

enum ScheduledTaskEditDraftSource {
  STRUCTURED
  AGENT
}

enum ScheduledTaskEditDraftStatus {
  PENDING
  CONFIRMED
  DISCARDED
}

enum ScheduledTaskExecutionStatus {
  PENDING
  CLAIMED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
}

enum ScheduledTaskDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
  SKIPPED
}

enum CollectionType {
  COMPANY
  INDUSTRY
  WATCHLIST
}

model Collection {
  id             String         @id @default(cuid())
  userId         String
  collectionType CollectionType
  title          String
  description    String?
  tags           String[]       @default([])
  payload        Json           @default("{}")
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mindMaps CollectionMindMap[]

  @@unique([userId, collectionType, title])
  @@index([userId, collectionType, updatedAt])
  @@index([userId, archivedAt])
}

model MindMap {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  data        Json
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections CollectionMindMap[]
  references  MindMapReference[]

  @@index([userId, updatedAt])
}

model CollectionMindMap {
  collectionId String
  mindMapId    String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  mindMap    MindMap    @relation(fields: [mindMapId], references: [id], onDelete: Cascade)

  @@id([collectionId, mindMapId])
  @@index([mindMapId, createdAt])
}

model MindMapReference {
  id           String   @id @default(cuid())
  mindMapId    String
  nodeId       String?
  targetType   String
  targetId     String
  relationType String?
  createdAt    DateTime @default(now())

  mindMap MindMap @relation(fields: [mindMapId], references: [id], onDelete: Cascade)

  @@index([mindMapId, nodeId])
  @@index([targetType, targetId])
}

model ScheduledTask {
  id                  String                   @id @default(cuid())
  userId              String
  name                String
  status              ScheduledTaskStatus      @default(DRAFT)
  currentVersion      Int                      @default(1)
  timezone            String                   @default("Asia/Shanghai")
  nextRunAt           DateTime?
  setupConversationId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions            ScheduledTaskVersion[]
  executions          ScheduledTaskExecution[]
  editDrafts          ScheduledTaskEditDraft[]

  @@index([status, nextRunAt])
  @@index([userId, status])
  @@index([userId, status, setupConversationId])
}

model ScheduledTaskEditDraft {
  id             String                       @id @default(cuid())
  taskId         String
  userId         String
  conversationId String?
  source         ScheduledTaskEditDraftSource
  status         ScheduledTaskEditDraftStatus @default(PENDING)
  baseVersion    Int
  revision       Int                          @default(1)
  name           String
  userPrompt     String
  scheduleSpec   Json
  dataSources    Json                         @default("[]")
  executionPlan  Json
  outputSpec     Json
  deliverySpec   Json
  feasibility    Json                         @default("{}")
  changes        Json                         @default("[]")
  nextRunAt      DateTime?
  idempotencyKey String?                      @unique
  confirmedAt    DateTime?
  discardedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  task           ScheduledTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status, updatedAt])
  @@index([userId, status, updatedAt])
  @@index([conversationId, status])
}

model ScheduledTaskVersion {
  id             String                   @id @default(cuid())
  taskId         String
  version        Int
  userPrompt     String
  scheduleSpec   Json
  dataSources    Json                     @default("[]")
  executionPlan  Json
  outputSpec     Json
  deliverySpec   Json
  feasibility    Json                     @default("{}")
  idempotencyKey String?                  @unique
  createdAt      DateTime                 @default(now())
  task           ScheduledTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  executions     ScheduledTaskExecution[]

  @@unique([taskId, version])
  @@index([taskId, createdAt])
}

model ScheduledTaskExecution {
  id                String                        @id @default(cuid())
  taskId            String
  taskVersionId     String
  scheduledAt       DateTime
  status            ScheduledTaskExecutionStatus  @default(PENDING)
  trigger           ScheduledTaskExecutionTrigger @default(SCHEDULED)
  deliveryRequested Boolean                       @default(false)
  idempotencyKey    String?                       @unique
  workerId          String?
  fencingToken      BigInt                        @default(0)
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  nextAttemptAt     DateTime?
  agentRunId        String?
  result            Json?
  error             Json?
  attempts          Int                           @default(0)
  claimedAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  eventPublishedAt  DateTime?
  lastEventError    Json?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  task              ScheduledTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskVersion       ScheduledTaskVersion          @relation(fields: [taskVersionId], references: [id], onDelete: Cascade)
  evidence          ScheduledTaskEvidence[]
  deliveries        ScheduledTaskDelivery[]
  scoreResults      ScheduledTaskScoreResult[]

  @@unique([taskId, taskVersionId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([taskId, status])
  @@index([status, eventPublishedAt])
  @@index([completedAt, eventPublishedAt])
  @@index([status, leaseExpiresAt])
  @@index([status, nextAttemptAt])
}

model ScheduledTaskScoreResult {
  id               String                 @id @default(cuid())
  executionId      String
  stockCode        String
  stockName        String
  rank             Int
  selected         Boolean                @default(false)
  evaluationStatus String
  score            Float
  maxScore         Float
  ruleResults      Json
  createdAt        DateTime               @default(now())
  execution        ScheduledTaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stockCode])
  @@unique([executionId, rank])
  @@index([executionId, selected, rank])
}

model ScheduledTaskEvidence {
  id          String                 @id @default(cuid())
  executionId String
  sourceType  String
  sourceId    String
  title       String?
  url         String?
  observedAt  DateTime?
  content     String?
  metadata    Json?
  createdAt   DateTime               @default(now())
  execution   ScheduledTaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model ScheduledTaskDelivery {
  id          String                      @id @default(cuid())
  executionId String
  targetType  String
  targetRef   String?
  status      ScheduledTaskDeliveryStatus @default(PENDING)
  attempts    Int                         @default(0)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  execution   ScheduledTaskExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, targetType, targetRef])
  @@index([status, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ScreeningWorkspace {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String?
  stockCodes     String[]  @default([])
  indicatorIds   String[]  @default([])
  formulaIds     String[]  @default([])
  timeConfig     Json
  filterRules    Json
  sortState      Json?
  columnState    Json
  resultSnapshot Json?
  universe       Json      @default("{\"type\":\"STOCKS\",\"stockCodes\":[]}")
  lastFetchedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs ScreeningRun[]

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@index([userId, name])
}

enum ScreeningRunStatus {
  PENDING
  RUNNING
  RETRYING
  SUCCEEDED
  PARTIAL
  FAILED
}

model ScreeningRun {
  id             String               @id @default(cuid())
  workspaceId    String
  userId         String
  status         ScreeningRunStatus   @default(PENDING)
  config         Json
  universeCount  Int?
  totalCount     Int?
  warnings       Json                 @default("[]")
  diagnostics    Json                 @default("{}")
  attempts       Int                  @default(0)
  workerId       String?
  fencingToken   BigInt               @default(0)
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  nextAttemptAt  DateTime?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      ScreeningWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  results        ScreeningRunResult[]

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([status, leaseExpiresAt])
}

model ScreeningRunResult {
  id        String       @id @default(cuid())
  runId     String
  stockCode String
  rank      Int
  run       ScreeningRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stockCode])
  @@unique([runId, rank])
  @@index([runId, rank])
}

model ScreeningFormula {
  id               String   @id @default(cuid())
  userId           String
  name             String
  expression       String
  targetIndicators Json
  description      String?
  categoryId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model WatchList {
  id          String   @id @default(cuid())
  name        String
  description String?
  stocks      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  timingResearchReports TimingResearchReport[]

  @@index([userId])
  @@index([name])
}

model SavedCompany {
  id           String    @id @default(cuid())
  userId       String
  stockCode    String
  companyName  String
  reason       String?
  tags         String[]  @default([])
  metadataJson Json      @default("{}")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stockCode])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

model SellSideBrokerRecommendation {
  id        String   @id @default(cuid())
  month     String
  broker    String
  tsCode    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, broker, tsCode])
  @@index([month, tsCode])
}

model SellSideEarningsForecast {
  id          String   @id @default(cuid())
  sourceKey   String   @unique
  tsCode      String
  name        String
  reportDate  String
  reportTitle String?
  orgName     String
  quarter     String
  eps         Float?
  netProfit   Float?
  rating      String?
  maxPrice    Float?
  minPrice    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tsCode, orgName, quarter, reportDate])
  @@index([reportDate])
}

model SellSideRefreshState {
  id                        String    @id
  latestRecommendationMonth String?
  latestForecastDate        String?
  lastSuccessfulAt          DateTime?
  lastError                 String?
  updatedAt                 DateTime  @updatedAt
}

model SavedIndustry {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  source               String
  reason               String?
  tags                 String[]  @default([])
  relatedCompaniesJson Json      @default("[]")
  metadataJson         Json      @default("{}")
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, name])
  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

model ResearchNote {
  id              String   @id @default(cuid())
  userId          String
  targetType      String
  targetId        String
  title           String?
  kind            String?
  contentMarkdown String
  rawContent      String?
  sourceJson      Json?
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetType, targetId, updatedAt])
  @@index([userId, updatedAt])
}

model FinancialSnapshot {
  id              String   @id @default(cuid())
  userId          String
  targetType      String
  targetId        String
  companyRefsJson Json
  metricSetJson   Json
  periodRangeJson Json
  rawSnapshotJson Json
  sourceJson      Json
  createdAt       DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifacts ResearchArtifact[]

  @@index([userId, targetType, targetId, createdAt])
  @@index([userId, createdAt])
}

model ResearchArtifact {
  id                  String   @id @default(cuid())
  userId              String
  targetType          String
  targetId            String
  financialSnapshotId String?
  artifactType        String
  title               String
  contentType         String
  payloadJson         Json
  sourceJson          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialSnapshot FinancialSnapshot? @relation(fields: [financialSnapshotId], references: [id], onDelete: SetNull)

  @@index([userId, targetType, targetId, updatedAt])
  @@index([financialSnapshotId])
  @@index([userId, artifactType, updatedAt])
}

model SharedNewsDaySync {
  id             String    @id @default(cuid())
  date           DateTime  @unique
  status         String
  leaseExpiresAt DateTime?
  attemptedAt    DateTime?
  completedAt    DateTime?
  warnings       String[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
}

model SharedNewsItem {
  id           String   @id @default(cuid())
  sourceItemId String   @unique
  sourceKind   String
  sourceName   String
  url          String?
  title        String
  content      String
  publishedAt  DateTime
  contentHash  String
  rawPayload   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([publishedAt])
  @@index([sourceKind, publishedAt])
  @@index([contentHash])
}

model EvidenceContext {
  id            String   @id @default(cuid())
  userId        String
  workflowRunId String?
  schemaVersion String   @default("1.0")
  subjectType   String
  subjectId     String
  subjectLabel  String?
  phase         String?
  metadataJson  Json
  createdAt     DateTime @default(now())

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun?           @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  blocks      EvidenceContextBlock[]
  items       EvidenceContextItem[]

  @@index([userId, subjectType, subjectId, createdAt])
  @@index([workflowRunId, createdAt])
}

model EvidenceContextBlock {
  id           String    @id @default(cuid())
  contextId    String
  blockKey     String
  status       String
  sourceType   String?
  sourceId     String?
  sourceName   String?
  sourceUrl    String?
  observedAt   DateTime?
  fetchedAt    DateTime?
  warnings     String[]  @default([])
  limitations  String[]  @default([])
  metadataJson Json
  createdAt    DateTime  @default(now())

  context EvidenceContext       @relation(fields: [contextId], references: [id], onDelete: Cascade)
  items   EvidenceContextItem[]

  @@unique([contextId, blockKey])
  @@index([blockKey, createdAt])
}

model EvidenceContextItem {
  id                 String    @id @default(cuid())
  contextId          String
  blockId            String
  userId             String
  itemKey            String
  status             String
  extractedFact      String?
  snippet            String?
  valueJson          Json?
  rawValueJson       Json?
  sourceType         String
  sourceId           String?
  sourceName         String?
  sourceUrl          String?
  publishedAt        DateTime?
  observedAt         DateTime?
  fetchedAt          DateTime?
  fallbackFrom       String?
  missingReason      String?
  warnings           String[]  @default([])
  limitations        String[]  @default([])
  metadataJson       Json
  recordKind         String    @default("observation")
  lineageId          String
  derivedFromItemIds String[]  @default([])
  algorithmVersion   String?
  parametersJson     Json?
  correctionOfItemId String?
  supersedesItemId   String?
  contentHash        String
  createdAt          DateTime  @default(now())

  context        EvidenceContext               @relation(fields: [contextId], references: [id], onDelete: Cascade)
  block          EvidenceContextBlock          @relation(fields: [blockId], references: [id], onDelete: Cascade)
  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotItems  ResearchContextSnapshotItem[]
  claimCitations ResearchClaimCitation[]

  @@index([lineageId, createdAt])
  @@index([correctionOfItemId])
  @@index([supersedesItemId])
  @@index([userId, contextId, createdAt])
  @@index([sourceType, sourceId])
}

model ResearchContextSnapshot {
  id                 String    @id @default(cuid())
  userId             String
  workflowRunId      String?
  requestGroupId     String
  requestSequence    Int
  attempt            Int       @default(1)
  purpose            String
  policy             String
  model              String?
  requestOptionsJson Json?
  messagesJson       Json
  qualityJson        Json
  projectionVersion  String
  contentHash        String
  status             String    @default("prepared")
  errorMessage       String?
  createdAt          DateTime  @default(now())
  sentAt             DateTime?
  completedAt        DateTime?

  user        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowRun WorkflowRun?                  @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  items       ResearchContextSnapshotItem[]
  claims      ResearchClaim[]

  @@unique([requestGroupId, attempt])
  @@index([userId, workflowRunId, createdAt])
  @@index([workflowRunId, requestSequence])
}

model ResearchContextSnapshotItem {
  id               String   @id @default(cuid())
  snapshotId       String
  evidenceItemId   String
  ordinal          Int
  projectionJson   Json
  projectionHash   String
  truncationReason String?
  createdAt        DateTime @default(now())

  snapshot     ResearchContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceContextItem     @relation(fields: [evidenceItemId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, evidenceItemId])
  @@unique([snapshotId, ordinal])
  @@index([evidenceItemId])
}

model ResearchClaim {
  id           String   @id @default(cuid())
  snapshotId   String
  artifactKey  String
  ordinal      Int
  text         String
  status       String
  qualityFlags String[] @default([])
  createdAt    DateTime @default(now())

  snapshot  ResearchContextSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  citations ResearchClaimCitation[]

  @@unique([snapshotId, artifactKey, ordinal])
  @@index([snapshotId, createdAt])
}

model ResearchClaimCitation {
  id             String   @id @default(cuid())
  claimId        String
  evidenceItemId String
  relation       String   @default("support")
  createdAt      DateTime @default(now())

  claim        ResearchClaim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceItem EvidenceContextItem @relation(fields: [evidenceItemId], references: [id], onDelete: Restrict)

  @@unique([claimId, evidenceItemId, relation])
  @@index([evidenceItemId])
