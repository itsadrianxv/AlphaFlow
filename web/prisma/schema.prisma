model DataObservationRevision {
  id                        String                                       @id @default(cuid())
  observationId             String
  revisionNo                Int
  revisionDedupKey          String                                       @unique
  canonicalizationVersion   String
  valueType                 String
  valueText                 String?
  valueJson                 Json?
