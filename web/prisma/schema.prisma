  upstreamAsOf              DateTime?                                    @db.Timestamptz(3)
  sourcePublishedAt         DateTime?                                    @db.Timestamptz(3)
  normalizedAt              DateTime                                     @db.Timestamptz(3)
  createdAt                 DateTime                                     @default(now()) @db.Timestamptz(3)
  observation               DataObservation                              @relation("ObservationRevisions", fields: [observationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
